            "value": "prod"
          },
          {
            "selected": false,
            "text": "homol",
            "value": "homol"
          }
        ],
        "query": "prod,homol",
        "type": "custom",
        "allValue": ".*"
      },
      {
        "current": {
          "selected": false,
          "text": "pelada_api",
          "value": "pelada_api"
        },
        "description": "Job do scrape",
        "hide": 0,
        "includeAll": false,
        "label": "job",
        "multi": false,
        "name": "job",
        "options": [
          {
            "selected": true,
            "text": "pelada_api",
            "value": "pelada_api"
          }
        ],
        "query": "pelada_api",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "Pelada Chori - API Overview",
  "uid": null,
  "version": 1
}
